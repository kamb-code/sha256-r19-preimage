  T1 <- a5: +1*S1(arg0: a5 linear (coeff 1)); +1*Ch(arg0: a5 linear (coeff 1) | arg2: [Maj(arg1: a5 linear (coeff 1))]); -1*Maj(arg0: a5 linear (coeff 1)); -1*S0(arg0: a5 linear (coeff 1))
  T2 <- a5: +1*Ch(arg1: a5 linear (coeff 1)); -1*Maj(arg1: a5 linear (coeff 1))
  T3 <- a5: +1*Ch(arg2: a5 linear (coeff 1))

